{
  "name": "flockaround-web-render",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsdown",
    "build-watch": "tsdown --watch",
    "serve": "live-server --watch=\"dist/main.js,index.html\"",
    "dev": "concurrently 'pn build-watch' 'pn serve'",
    "typecheck": "tsc",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tsdown/css": "^0.23.1",
    "concurrently": "^10.0.5",
    "live-server": "^1.2.2",
    "sass-embedded": "^1.105.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "prettier": {
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ]
  }
}
